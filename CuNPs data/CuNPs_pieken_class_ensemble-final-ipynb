    "for idx, svc in enumerate(all_svc):\n",
    "\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(f\"MODEL {idx}\")\n",
    "    print(\"=\"*60)\n",
    "\n",
    "    gamma = svc.gamma\n",
    "    b = svc.intercept_[0]\n",
    "    n_sv = len(svc.support_vectors_)\n",
    "\n",
    "    print(rf\"\"\"\n",
    "Decision function:\n",
    "\n",
    "f(x) = Σ (i = 1 → {n_sv}) α_i · y_i · exp(-{gamma} · ||x - x_i||²) + b\n",
    "\n",
    "where:\n",
    "- b = {b:.4f}\n",
    "- γ = {gamma}\n",
    "- number of support vectors = {n_sv}\n",
    "\"\"\")"
   ]
