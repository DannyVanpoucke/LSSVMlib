    "# pairwise agreement meten hoevaak 2 modellen dezelfde voorspelling doen\n",
    "from itertools import combinations\n",
    "\n",
    "agreements = []\n",
    "\n",
    "for i, j in combinations(range(len(all_svc)), 2):\n",
    "    pred_i = all_svc[i].predict(X_scaled)\n",
    "    pred_j = all_svc[j].predict(X_scaled)\n",
    "\n",
    "    agreement = np.mean(pred_i == pred_j)\n",
    "    agreements.append(agreement)\n",
    "\n",
    "print(\"Mean agreement:\", np.mean(agreements))\n",
    "print(\"Std agreement:\", np.std(agreements))"
   ]
